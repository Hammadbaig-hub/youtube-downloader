GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=
DATABASE_URL=sqlite:///vidflow.db

# ── YouTube extraction ───────────────────────────────────────────────────────
# Solving YouTube's signature challenge needs a JS runtime (node/deno/bun) on
# PATH plus yt-dlp's EJS solver script, downloaded on demand from GitHub.
# Set to 1 only if the host blocks outbound GitHub traffic.
YTDLP_NO_REMOTE_COMPONENTS=
# Remedy for "Sign in to confirm you're not a bot". Netscape-format cookie file:
YTDLP_COOKIEFILE=
# Local dev alternative — pull cookies straight from an installed browser:
YTDLP_COOKIES_FROM_BROWSER=
